  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Tritanopia is a rare form of color blindness.\nPeople with this condition
    have difficulty distinguishing between:\n\n- Blue and green\n- Yellow and purple\n\nTritanopia
    is caused by a malfunction of S-cones, which are responsible for detecting blue
    light.\nUnlike red\u2013green color blindness, Tritanopia is not linked to the
    X chromosome and can sometimes be acquired due to eye disease, injury, or aging."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: d1728ba5990034831bbe01f3a2578b70, type: 2}
