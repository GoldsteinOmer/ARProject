      m_Calls: []
  m_text: "Protanopia is another form of red\u2013green color blindness.\nPeople
    with Protanopia have difficulty perceiving red light, and red colors may appear
    dark or black.\n\nProtanopia is caused by a malfunction or absence of L-cones,
    which are responsible for detecting red light.\nSince red contributes significantly
    to brightness perception, colors may appear dimmer overall.\n\nThis condition
    is genetic and present from birth."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: d1728ba5990034831bbe01f3a2578b70, type: 2}
  m_sharedMaterial: {fileID: 4687939059374929122, guid: d1728ba5990034831bbe01f3a2578b70, type: 2}
