  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Deuteranopia is a type of red\u2013green color blindness.\nPeople with
    this condition have difficulty distinguishing green and red colors, which may
    appear similar or brownish.\n\nDeuteranopia occurs due to a malfunction or absence
    of M-cones, the cone cells responsible for detecting green light.\nBecause green
    light information is missing or reduced, the brain cannot properly differentiate
    green from red.\n\nThis condition is genetic and congenital, and is more common
    in males."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: d1728ba5990034831bbe01f3a2578b70, type: 2}
  m_sharedMaterial: {fileID: 4687939059374929122, guid: d1728ba5990034831bbe01f3a2578b70, type: 2}
